# Copy this file to .env. Never commit the populated .env file.

# Robinhood Chain mainnet
CHAIN_ID=4663
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
PONS_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
BLOCKSCOUT_API_URL=https://robinhoodchain.blockscout.com/api

# Public Pons V2 factory and the EXISTING tokenized NVIDIA pairing asset.
# NVDA_TOKEN is not our project token. Pons creates NVDA lite later and its
# returned address goes into PROJECT_TOKEN_ADDRESS.
PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
NVDA_TOKEN=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC

# Deployment signer. Use a dedicated deployment wallet.
# PRIVATE_KEY must be a 0x-prefixed 32-byte value. Never paste a seed phrase.
DEPLOYER_ADDRESS=
PRIVATE_KEY=

# Immutable receiver configuration. These must be decided before deployment.
# Fixed wallet/multisig receiving only the accrued developer allocation.
PROJECT_TREASURY=
# Wallet permitted to bind the Pons token once; normally the safe deployer.
LAUNCH_BOOTSTRAPPER=
# Deployed production IReferenceOracle contract; it must be built first.
REFERENCE_ORACLE=

# Sorted, comma-separated reporter addresses. Use independent keys/services.
ORACLE_SIGNERS=
ORACLE_THRESHOLD=2
MAX_REPORT_VALIDITY_SECONDS=300
ORACLE_TWAP_WINDOW_SECONDS=1800
ORACLE_CONFIRMATIONS=100
ORACLE_HISTORY_BLOCKS=100000

# Raw NVDA units (NVDA has 18 decimals). Review these technical starting values.
MIN_BATCH_RAW=10000000000000000
MAX_BATCH_RAW=500000000000000000
MAX_SWAP_QUOTE_RAW=250000000000000000
MAX_ORACLE_AGE_SECONDS=120
MAX_TICK_DEVIATION=50
MAX_SWAP_LOSS_BPS=300

# Optional reproducible fork block. Leave blank to use the latest block.
PONS_FORK_BLOCK=

# Fill these from transaction outputs only after deployment, the Pons launch,
# and bindLaunch(). PROJECT_TOKEN_ADDRESS will be the new NVDA lite token.
RECEIVER_ADDRESS=
PROJECT_TOKEN_ADDRESS=
VAULT_ADDRESS=

# Robinhood's official Blockscout example accepts the literal value "empty".
BLOCKSCOUT_API_KEY=empty

# Pons launch metadata. Review every value before signing a launch transaction.
PONS_LAUNCH_CONFIG_ID=0
PONS_LAUNCH_SALT=
TOKEN_NAME=No Value Digital Asset
TOKEN_SYMBOL=NVLITE
TOKEN_LOGO_URI=
TOKEN_DESCRIPTION=Fund the liquidity of this no value digital asset.
TOKEN_TWITTER=https://x.com/nvdalite
TOKEN_TELEGRAM=
TOKEN_DISCORD=
TOKEN_WEBSITE=https://nvdalite.credit/
TOKEN_FARCASTER=
